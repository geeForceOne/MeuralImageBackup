@page "/duplicates"
@inherits AppPage
@inject IdenticalFilesService IdenticalFilesService

<PageTitle>Duplicates · @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <h1>Duplicates</h1>
        @if (_library is not null)
        {
            <p class="page-sub">
                @if (_identical is { Count: > 0 })
                {
                    <span>@($"{Format.Count(_identical.Count, "file is", "files are")} saved under more than one image")</span>
                    <span>@($"{Format.Size(_identical.Sum(g => g.Wasted))} in extra copies")</span>
                }
            </p>
        }
    </div>
    @if (_bulk is not null)
    {
        <div class="page-actions">
            <span class="busy-status" role="status" aria-live="polite">
                <BrandMark Size="22" Busy="true" />
                <span class="busy-text"><strong>@_bulkTitle</strong><span class="busy-detail">@_bulkStatus</span></span>
            </span>
            <button type="button" class="btn btn-secondary" disabled="@_bulk.IsCancellationRequested" @onclick="() => _bulk.Cancel()">
                <Icon Name="x" Size="16" />@(_bulk.IsCancellationRequested ? "Stopping…" : "Cancel")
            </button>
        </div>
    }
    else if (_finding is null && _identical is { Count: > 0 } all && _identicalShown.Count > 0)
    {
        <div class="page-actions">
            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="KeepOneOfEachIdenticalAsync"
                    title="Each group keeps its most shown image">
                <Icon Name="broom" Size="16" />@(_identicalShown.Count == all.Count ? "Keep one of each" : $"Keep one of these {Format.Number(_identicalShown.Count)}")
            </button>
        </div>
    }
</div>

<p class="dupe-tab-help muted small">
    Different images whose files are byte for byte the same: the same artwork uploaded to Meural twice, or the same image shown in two galleries (each gallery keeps its own entry and file).
</p>

@if (_library is null)
{
    <div class="page-loading"><BrandMark Size="40" Busy="true" /></div>
}
else
{
    @IdenticalFilesView
}

<ImageViewer Images="_viewing" @bind-Index="_viewingIndex" />

@code {
    private const int Page = 60;

    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Frame { get; set; }
    private Library? _library;
    private IReadOnlyList<IdenticalFiles>? _identical;
    private List<IdenticalFiles> _identicalShown = [];
    private CancellationTokenSource? _finding;
    private string _findStatus = "";
    private int _limit = Page;
    private IReadOnlyList<ImageView> _viewing = [];
    private int _viewingIndex = -1;
    private CancellationTokenSource? _bulk;
    private string _bulkTitle = "";
    private string _bulkStatus = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        _limit = Page;
        Apply();
        if (_library is not null && _identical is null && _finding is null)
            await FindIdenticalAsync();
    }

    private async Task LoadAsync()
    {
        _library = await LibraryService.LoadAsync(PageToken);
        Apply();
    }

    private void Apply()
    {
        if (_library is null) return;
        _identicalShown = (_identical ?? []).Where(g => g.Images.Any(i => Matches(i.Name, i.Copies))).ToList();
    }

    private bool Matches(string name, IEnumerable<ImageView> views) =>
        Filters.Matches(Q, [name, .. views.Select(v => v.GalleryName)]) &&
        (Frame is null || views.Any(v => v.FrameName == Frame));

    private void Set(string? q = null, string? frame = null)
    {
        ReplaceQuery(new Dictionary<string, object?>
        {
            ["q"] = q is null ? Q : q.Length == 0 ? null : q,
            ["frame"] = frame is null ? Frame : frame.Length == 0 ? null : frame,
        });
    }

    private void ClearFilters() => ReplaceQuery(new Dictionary<string, object?> { ["q"] = null, ["frame"] = null });

    private void Open(IEnumerable<ImageView> views)
    {
        _viewing = views.ToList();
        _viewingIndex = 0;
    }

    private RenderFragment FilterBar() => __builder =>
    {
        <div class="filters">
            <label class="filter-search">
                <Icon Name="search" />
                <input data-bwignore="true" type="search" placeholder="Find an image or gallery" aria-label="Find an image or gallery"
                       value="@Q" @oninput="e => Set(q: e.Value?.ToString())" />
            </label>
            @if (_library!.Frames.Count > 1)
            {
                <label class="filter-select">
                    <span>Frame</span>
                    <select class="select" value="@(Frame ?? "")" @onchange="e => Set(frame: e.Value?.ToString())">
                        <option value="">All frames</option>
                        @foreach (var f in _library.Frames)
                        {
                            <option value="@f">@f</option>
                        }
                    </select>
                </label>
            }
        </div>
    };

    private RenderFragment NoMatch => __builder =>
    {
        <div class="empty">
            <Icon Name="search" Size="28" />
            <p>No duplicate matches these filters.</p>
            <button type="button" class="btn btn-secondary" @onclick="ClearFilters">Show all duplicates</button>
        </div>
    };

    private RenderFragment More(int count) => __builder =>
    {
        @if (count > _limit)
        {
            <div class="more">
                <button type="button" class="btn btn-secondary" @onclick="() => _limit += Page">
                    @($"Show {Format.Number(Math.Min(Page, count - _limit))} more")
                </button>
                <span class="muted small">@($"{Format.Number(_limit)} of {Format.Number(count)} shown")</span>
            </div>
        }
    };

    private RenderFragment IdenticalFilesView => __builder =>
    {
        @if (_finding is not null)
        {
            <div class="empty dupe-finding" role="status" aria-live="polite">
                <BrandMark Size="40" Busy="true" />
                <h2>Comparing files…</h2>
                <p class="busy-detail">@_findStatus</p>
                <button type="button" class="btn btn-secondary" disabled="@_finding.IsCancellationRequested" @onclick="() => _finding.Cancel()">
                    <Icon Name="x" Size="16" />@(_finding.IsCancellationRequested ? "Stopping…" : "Cancel")
                </button>
            </div>
        }
        else if (_identical is null)
        {
            <div class="empty">
                <Icon Name="file" Size="28" />
                <p>The comparison was stopped.</p>
                <button type="button" class="btn btn-secondary" @onclick="FindIdenticalAsync"><Icon Name="sync" Size="16" />Compare files</button>
            </div>
        }
        else if (_identical.Count == 0)
        {
            <div class="empty">
                <BrandMark Size="64" PlayOnLoad="true" />
                <h2>No identical files</h2>
                <p>No two images have the same file. Files on disk that the database doesn't list yet are only compared after <a href="">Sync with disk</a>.</p>
                <button type="button" class="btn btn-ghost" @onclick="RecompareAsync"><Icon Name="sync" Size="16" />Compare again</button>
            </div>
        }
        else
        {
            <div class="notice notice-row">
                <Icon Name="info" />
                <span>
                    Keeping one image removes the others: their files and their entries in their galleries. The kept image stays as it is.
                    If a frame shows a removed image again, it's saved again.
                </span>
            </div>

            @FilterBar()

            <p class="result-count muted small">
                @(_identicalShown.Count == _identical.Count ? Format.Count(_identicalShown.Count, "group", "groups") : $"{Format.Number(_identicalShown.Count)} of {Format.Count(_identical.Count, "group", "groups")}")
                <button type="button" class="link-button" disabled="@Busy" @onclick="RecompareAsync">Compare again</button>
            </p>

            @if (_identicalShown.Count == 0)
            {
                @NoMatch
            }
            else
            {
                <div class="dupe-list">
                    @foreach (var g in _identicalShown.Take(_limit))
                    {
                        var group = g;
                        <article @key="g.Hash" class="dupe">
                            <button type="button" class="dupe-photo" title="View large" @onclick="() => Open(group.Images.SelectMany(i => i.Copies))">
                                <img src="@ImageTile.ThumbUrl(g.Keeper.Copies[0])" alt="" loading="lazy" decoding="async" />
                            </button>
                            <div class="dupe-body">
                                <div class="dupe-head">
                                    <h2 class="dupe-name">@(g.SharedFile ? $"{Format.Count(g.Images.Count, "image shares", "images share")} one file" : $"{Format.Count(g.Images.Count, "image", "images")} with the same file")</h2>
                                    <span class="dupe-meta">
                                        @if (g.SharedFile)
                                        {
                                            <span title="Same title in the same gallery, so one file on disk: removing the others frees no space">@($"{Format.Size(g.Size)}, stored once")</span>
                                        }
                                        else
                                        {
                                            <span>@($"{Format.Count(g.Files, "file", "files")} of {Format.Size(g.Size)}, {Format.Size(g.Wasted)} extra")</span>
                                        }
                                    </span>
                                </div>
                                <ul class="dupe-copies">
                                    @foreach (var i in g.Images)
                                    {
                                        var image = i;
                                        <li class="dupe-copy">
                                            <span class="dupe-where">
                                                <span class="dupe-gallery">
                                                    @i.Name
                                                    @if (i == g.Keeper)
                                                    {
                                                        <span class="tag" title="&quot;Keep one of each&quot; keeps the most shown image">Most shown</span>
                                                    }
                                                </span>
                                                <span class="dupe-sub">
                                                    <span>
                                                        @for (var n = 0; n < i.Copies.Count; n++)
                                                        {
                                                            var copy = i.Copies[n];
                                                            if (n > 0) { <text>, </text> }
                                                            <a href="@($"g/{copy.GalleryId}")">@copy.GalleryName</a>
                                                            @if (_library!.Frames.Count > 1) { <text> (@copy.FrameName)</text> }
                                                        }
                                                    </span>
                                                    <span>@($"Shown {Format.Count(i.AccessCount, "time", "times")}")</span>
                                                    <span title="Meural's id for this image">@($"Meural id {i.FileId}")</span>
                                                </span>
                                            </span>
                                            <button type="button" class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="() => KeepImageAsync(group, image)"
                                                    title="Removes the other images of this group">
                                                <Icon Name="check" Size="15" />Keep this one
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </article>
                    }
                </div>
                @More(_identicalShown.Count)
            }
        }
    };

    // Identical files: keeps the chosen image and removes the group's others, right away (no
    // confirmation, the user's choice: the kept image and its file stay).
    private async Task KeepImageAsync(IdenticalFiles group, IdenticalImage keep)
    {
        var others = group.Images.Where(i => i.Id != keep.Id).ToList();
        var files = 0;
        var bytes = 0L;
        if (await RunAsync(async () =>
            {
                foreach (var other in others)
                {
                    var (f, b) = await LibraryService.RemoveIdenticalAsync(keep.Id, other.Id, PageToken);
                    files += f;
                    bytes += b;
                }
            }))
        {
            Ui.Toast.Success(files == 0
                ? $"Kept {keep.Name}, removed {Format.Count(others.Count, "image", "images")}; they shared its file."
                : $"Kept {keep.Name}, removed {Format.Count(others.Count, "image", "images")} and {Format.Count(files, "file", "files")} ({Format.Size(bytes)}).");
            // The group goes right away and the others close the gap; the quiet refresh below
            // only changes the list if something else changed too.
            _identical = _identical?.Where(g => g.Hash != group.Hash).ToList();
            Apply();
            StateHasChanged();
        }
        await ReloadAsync();
    }

    private async Task KeepOneOfEachIdenticalAsync()
    {
        var groups = _identicalShown.ToList();
        var images = groups.Sum(g => g.Images.Count - 1);
        var ok = await Ui.Confirm.AskAsync(
            $"Remove {Format.Count(images, "image", "images")}?",
            $"Each of the {Format.Count(groups.Count, "group", "groups")} keeps its most shown image; the others are removed with their files ({Format.Size(groups.Sum(g => g.Wasted))}). It can't be undone.",
            "Remove", danger: true);
        if (!ok) return;

        var result = await RunBulkAsync("Removing identical files…", (progress, ct) => LibraryService.RemoveIdenticalAsync(groups, progress, ct),
            "Stopped. The images removed until then are gone; the rest are as they were.");
        if (result is not null)
            Ui.Toast.Success($"Removed {Format.Count(result.Images, "image", "images")} and {Format.Count(result.FilesDeleted, "file", "files")} ({Format.Size(result.BytesFreed)}).");
    }

    // Runs a long action with its progress in the page head and a Cancel button, then reloads.
    private async Task<DedupeResult?> RunBulkAsync(string title, Func<IProgress<string>, CancellationToken, Task<DedupeResult>> work, string stoppedMessage)
    {
        DedupeResult? result = null;
        bool done;
        using (var bulk = CancellationTokenSource.CreateLinkedTokenSource(PageToken))
        {
            _bulk = bulk;
            _bulkTitle = title;
            _bulkStatus = "";
            var progress = ThrottledProgress(s => _bulkStatus = s);
            try
            {
                done = await RunAsync(async () => result = await work(progress, bulk.Token));
            }
            finally
            {
                _bulk = null;
            }
            if (!done && bulk.IsCancellationRequested && !PageToken.IsCancellationRequested)
                Ui.Toast.Info(stoppedMessage);
        }
        if (!PageToken.IsCancellationRequested)
            await ReloadAsync();
        return done ? result : null;
    }

    private async Task FindIdenticalAsync()
    {
        if (_library is null || _finding is not null) return;
        using var finding = CancellationTokenSource.CreateLinkedTokenSource(PageToken);
        _finding = finding;
        _findStatus = "Starting";
        StateHasChanged();
        try
        {
            _identical = await IdenticalFilesService.FindAsync(_library, ThrottledProgress(s => _findStatus = s), finding.Token);
        }
        catch (OperationCanceledException)
        {
            ClearIdentical();
        }
        finally
        {
            _finding = null;
        }
        Apply();
        StateHasChanged();
    }

    private async Task RecompareAsync()
    {
        await LoadAsync();
        ClearIdentical();
        await FindIdenticalAsync();
    }

    // After a change: the library and the identical files again (quick: the fingerprints are
    // known). The list stays on screen meanwhile; the "Comparing files" screen is only for when
    // there's no list yet, so nothing flickers.
    private async Task ReloadAsync()
    {
        await LoadAsync();
        if (_identical is not null)
            await RefreshIdenticalQuietlyAsync();
        else
            await FindIdenticalAsync();
    }

    // Compares again without the busy screen and swaps the list when done. A newer refresh wins.
    private int _refreshes;

    private async Task RefreshIdenticalQuietlyAsync()
    {
        if (_library is null) return;
        var mine = ++_refreshes;
        try
        {
            var found = await IdenticalFilesService.FindAsync(_library, null, PageToken);
            if (mine != _refreshes) return;
            _identical = found;
            Apply();
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Forgets the comparison. The visible groups go with it, so nothing renders a list that's gone.
    private void ClearIdentical()
    {
        _identical = null;
        _identicalShown = [];
    }

    // Progress<T> reports on the circuit's context; redraw at most a few times a second.
    private Progress<string> ThrottledProgress(Action<string> set)
    {
        var sinceRender = System.Diagnostics.Stopwatch.StartNew();
        return new Progress<string>(status =>
        {
            set(status);
            if (sinceRender.ElapsedMilliseconds < 200) return;
            sinceRender.Restart();
            StateHasChanged();
        });
    }
}
