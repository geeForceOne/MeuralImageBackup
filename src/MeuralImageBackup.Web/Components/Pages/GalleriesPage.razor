@page "/"
@page "/Gallery"
@inherits AppPage
@inject Prefs Prefs

<PageTitle>Galleries · @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <h1>Galleries</h1>
        @if (_library is { } lib)
        {
            <p class="page-sub">
                <span>@Format.Count(lib.Galleries.Count, "gallery", "galleries") on @Format.Count(lib.Frames.Count, "frame", "frames")</span>
            </p>
        }
    </div>
    @if (_library is not null)
    {
        <div class="page-actions">
            @if (_sync is not null)
            {
                <span class="busy-status" role="status" aria-live="polite">
                    <BrandMark Size="22" Busy="true" />
                    <span class="busy-text"><strong>@_syncTitle</strong><span class="busy-detail">@_syncStatus</span></span>
                </span>
                <button type="button" class="btn btn-secondary" disabled="@_sync.IsCancellationRequested" @onclick="() => _sync.Cancel()">
                    <Icon Name="x" Size="16" />@(_sync.IsCancellationRequested ? "Stopping…" : "Cancel")
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="SyncAsync"
                        title="Adds the galleries and images found in the uploads folder that the database doesn't list">
                    <Icon Name="sync" Size="16" />Sync with disk
                </button>
            }
        </div>
    }
</div>

@if (_library is null)
{
    <div class="page-loading"><BrandMark Size="40" Busy="true" /></div>
}
else if (_library.Galleries.Count == 0)
{
    <div class="empty">
        <BrandMark Size="64" PlayOnLoad="true" />
        <h2>Nothing collected yet</h2>
        <p>As soon as Home Assistant reports the first image a frame shows, its gallery appears here and the image is saved.</p>
        <p class="small"><code>POST /api/meural</code> with <code>frameName</code>, <code>gallery</code>, <code>title</code>, <code>url</code> and <code>id</code>.</p>
    </div>
}
else
{
    <div class="stats">
        <div class="stat"><span class="stat-value num">@Format.Number(_library.Galleries.Count)</span><span class="stat-label">Galleries</span></div>
        <a class="stat" href="images"><span class="stat-value num">@Format.Number(_library.Images.Count)</span><span class="stat-label">Images</span></a>
        <div class="stat"><span class="stat-value num">@Format.Size(_library.DiskSize)</span><span class="stat-label">On disk</span></div>
        @if (_missing > 0)
        {
            <a class="stat stat-warn" href="images?missing=true"><span class="stat-value num">@Format.Number(_missing)</span><span class="stat-label">Files missing</span></a>
        }
    </div>

    @if (_library.Legacy is { } legacy)
    {
        <div class="notice notice-warn notice-row">
            <Icon Name="copies" />
            <span>
                @($"{Format.Count(legacy.Images, "image is", "images are")} listed in more than one gallery by an early test version. Now an image belongs to one gallery only. ")
                @(legacy.Files > 0
                    ? $"Cleaning up keeps each image in the gallery it was first shown in and deletes {Format.Count(legacy.Files, "extra copy", "extra copies")} ({Format.Size(legacy.Bytes)})."
                    : "Cleaning up keeps each image in the gallery it was first shown in; no file needs deleting.")
            </span>
            <button type="button" class="btn btn-primary btn-sm" disabled="@Busy" @onclick="CleanUpLegacyAsync">
                <Icon Name="broom" Size="16" />Clean up
            </button>
        </div>
    }

    <div class="filters">
        <label class="filter-search">
            <Icon Name="search" />
            <input data-bwignore="true" type="search" placeholder="Find a gallery" aria-label="Find a gallery"
                   value="@Q" @oninput="e => Set(q: e.Value?.ToString())" />
        </label>
        @if (_library.Frames.Count > 1)
        {
            <label class="filter-select">
                <span>Frame</span>
                <select class="select" value="@(Frame ?? "")" @onchange="e => Set(frame: e.Value?.ToString())">
                    <option value="">All frames</option>
                    @foreach (var f in _library.Frames)
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </label>
        }
        <label class="filter-select">
            <span>Not shown for</span>
            <select class="select" value="@(Age?.ToString() ?? "")" @onchange="e => Set(age: int.TryParse(e.Value?.ToString(), out var d) ? d : 0)">
                @foreach (var (days, label) in Filters.Ages)
                {
                    <option value="@(days?.ToString() ?? "")">@label</option>
                }
            </select>
        </label>
        <div class="@(_view == "table" ? "sort-picker-phone" : "")">
            <SortPicker Choices="Filters.GallerySorts" Current="@SortKey" Descending="Descending" OnSort="PickSortAsync" />
        </div>
        <div class="segmented filter-view" role="group" aria-label="View">
            <button type="button" class="@(_view == "grid" ? "on" : "")" aria-pressed="@(_view == "grid" ? "true" : "false")" title="Cards" aria-label="Cards" @onclick='() => SetViewAsync("grid")'><Icon Name="grid" Size="16" /></button>
            <button type="button" class="@(_view == "table" ? "on" : "")" aria-pressed="@(_view == "table" ? "true" : "false")" title="Table" aria-label="Table" @onclick='() => SetViewAsync("table")'><Icon Name="list" Size="16" /></button>
        </div>
    </div>

    @if (Age is not null && _shown.Count > 0)
    {
        <div class="notice notice-warn notice-row">
            <Icon Name="broom" />
            <span>
                @($"{Format.Count(_shown.Count, "gallery hasn't", "galleries haven't")} been shown for {Filters.Ages.First(a => a.Days == Age).Label}, with {Format.Count(_shown.Sum(g => g.Images.Count), "image", "images")} ({Format.Size(_shown.Sum(g => g.Size))}).")
            </span>
            <button type="button" class="btn btn-danger btn-sm" disabled="@Busy" @onclick="DeleteShownAsync">
                <Icon Name="trash" Size="16" />@($"Delete {Format.Count(_shown.Count, "gallery", "galleries")}")
            </button>
        </div>
    }

    @if (_shown.Count == 0)
    {
        <div class="empty">
            <Icon Name="search" Size="28" />
            <p>No gallery matches these filters.</p>
            <button type="button" class="btn btn-secondary" @onclick="ClearFilters">Show all galleries</button>
        </div>
    }
    else if (_view == "table")
    {
        var showFrame = _library.Frames.Count > 1;
        <div class="table-scroll">
            <table class="table image-table gallery-table">
                <thead>
                    <tr>
                        <th class="image-table-photo"><span class="visually-hidden">Cover</span></th>
                        <SortHeader Key="name" Label="Name" Current="@SortKey" Descending="Descending" OnSort="HeaderSortAsync" />
                        @if (showFrame)
                        {
                            <SortHeader Key="frame" Label="Frame" Current="@SortKey" Descending="Descending" OnSort="HeaderSortAsync" />
                        }
                        <SortHeader Key="images" Label="Images" Class="num" Current="@SortKey" Descending="Descending" OnSort="HeaderSortAsync" />
                        <SortHeader Key="shown" Label="Shown" Class="num" Current="@SortKey" Descending="Descending" OnSort="HeaderSortAsync" />
                        <SortHeader Key="recent" Label="Last shown" Current="@SortKey" Descending="Descending" OnSort="HeaderSortAsync" />
                        <SortHeader Key="added" Label="Added" Class="hide-tablet" Current="@SortKey" Descending="Descending" OnSort="HeaderSortAsync" />
                        <SortHeader Key="size" Label="Size" Class="num hide-tablet" Current="@SortKey" Descending="Descending" OnSort="HeaderSortAsync" />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in _shown)
                    {
                        var gallery = g;
                        var cover = g.Images.FirstOrDefault(i => i.Exists);
                        <tr @key="g.Id" class="clickable" @onclick='() => Nav.NavigateTo($"g/{gallery.Id}")'>
                            <td class="image-table-photo">
                                @if (cover is not null)
                                {
                                    <img src="@ImageTile.ThumbUrl(cover)" alt="" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="image-table-nophoto" title="@(g.Images.Count == 0 ? "No images yet" : "Files missing")"><Icon Name="image" Size="18" /></span>
                                }
                            </td>
                            <td class="image-table-name" data-label="Name">
                                <a href="@($"g/{g.Id}")" @onclick:stopPropagation="true">@g.Name</a>
                                @if (g.Missing > 0)
                                {
                                    <span class="tag tag-warn">@Format.Count(g.Missing, "file missing", "files missing")</span>
                                }
                            </td>
                            @if (showFrame)
                            {
                                <td data-label="Frame">@g.FrameName</td>
                            }
                            <td class="num" data-label="Images">@Format.Number(g.Images.Count)</td>
                            <td class="num" data-label="Shown">@Format.Number(g.AccessCount)</td>
                            <td data-label="Last shown" title="@Format.DateTime(g.LastAccessedAt, Zone)">@Format.Date(g.LastAccessedAt, Zone)</td>
                            <td class="hide-tablet" data-label="Added" title="@Format.DateTime(g.CreatedAt, Zone)">@Format.Date(g.CreatedAt, Zone)</td>
                            <td class="num muted hide-tablet" data-label="Size">@Format.Size(g.Size)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="gallery-grid">
            @foreach (var g in _shown)
            {
                <GalleryCard @key="g.Id" Gallery="g" ShowFrame="@(_library.Frames.Count > 1)" />
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Frame { get; set; }
    [SupplyParameterFromQuery] public int? Age { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? Dir { get; set; }

    private const string ViewPref = "galleriesView";
    private const string SortPref = "galleriesSort";

    private Library? _library;
    private List<GalleryView> _shown = [];
    private int _missing;
    private string _view = "grid";
    private (string? Sort, string? Dir) _remembered;
    private CancellationTokenSource? _sync;
    private string _syncTitle = "";
    private string _syncStatus = "";

    // The view and sort this browser used last (prerendering is off, so the browser can be asked
    // before the first render). A URL with its own sort wins.
    protected override async Task OnInitializedAsync()
    {
        _view = await Prefs.GetAsync(ViewPref) == "table" ? "table" : "grid";
        _remembered = await Prefs.GetSortAsync(SortPref);
        await LoadAsync();
    }

    protected override void OnParametersSet() => Apply();

    private bool SortInUrl => Sort is not null || Dir is not null;
    private string SortKey => Filters.Known(SortInUrl ? Sort : _remembered.Sort, Filters.GallerySorts);
    private string? SortDir => SortInUrl ? Dir : _remembered.Dir;
    private bool Descending => Filters.IsDescending(SortKey, SortDir);

    private async Task SetViewAsync(string view)
    {
        _view = view;
        await Prefs.SetAsync(ViewPref, view);
    }

    // A header sorts by its column; clicking the sorted one again reverses it.
    private Task HeaderSortAsync(string key) =>
        SetSortAsync(key, key == SortKey ? !Descending : Filters.NaturallyDescending(key));

    private Task PickSortAsync((string Sort, bool? Descending) pick) =>
        SetSortAsync(pick.Sort, pick.Descending ?? Filters.NaturallyDescending(pick.Sort));

    private async Task SetSortAsync(string key, bool descending)
    {
        key = Filters.Known(key, Filters.GallerySorts);
        var dir = Filters.Dir(key, descending);
        _remembered = (key, dir);
        await Prefs.SetSortAsync(SortPref, key, dir);
        // Written out in full, so the URL keeps this sort even where it's the default.
        ReplaceQuery(new Dictionary<string, object?> { ["q"] = Q, ["frame"] = Frame, ["age"] = Age, ["sort"] = key, ["dir"] = dir });
    }

    private async Task LoadAsync()
    {
        _library = await LibraryService.LoadAsync(PageToken);
        _missing = _library.Images.Count(i => !i.Exists);
        Apply();
    }

    private void Apply()
    {
        if (_library is null) return;
        var matching = _library.Galleries.Where(g =>
            Filters.Matches(Q, g.Name) &&
            (Frame is null || g.FrameName == Frame) &&
            Filters.OlderThan(g.LastAccessedAt, Age));
        _shown = Filters.Sort(matching, SortKey, SortDir).ToList();
    }

    // Changes some filters, keeping the others and the sort; "" or 0 clears one.
    private void Set(string? q = null, string? frame = null, int? age = null)
    {
        ReplaceQuery(new Dictionary<string, object?>
        {
            ["q"] = q is null ? Q : q.Length == 0 ? null : q,
            ["frame"] = frame is null ? Frame : frame.Length == 0 ? null : frame,
            ["age"] = age is null ? Age : age == 0 ? null : age,
        });
    }

    private void ClearFilters() =>
        ReplaceQuery(new Dictionary<string, object?> { ["q"] = null, ["frame"] = null, ["age"] = null });

    // Adds what's in the uploads folder but not in the database; nothing is removed. It can take a
    // while on a big collection, so it shows what it's doing and can be stopped; what it added up
    // to then stays.
    private async Task SyncAsync()
    {
        var result = await RunLongAsync("Syncing with disk…", (progress, ct) => LibraryService.SyncWithDiskAsync(progress, ct),
            "Sync stopped. What it had added so far stays.");
        if (result is null)
            return;
        if (result.Changed)
        {
            var parts = new List<string>();
            if (result.GalleriesAdded > 0) parts.Add($"{Format.Count(result.GalleriesAdded, "gallery", "galleries")} added");
            if (result.ImagesAdded > 0) parts.Add($"{Format.Count(result.ImagesAdded, "image", "images")} added");
            Ui.Toast.Success("Synced: " + string.Join(", ", parts) + ".");
        }
        else
        {
            Ui.Toast.Success("Everything on disk is listed already.");
        }
        if (result.Skipped > 0)
            Ui.Toast.Info($"{Format.Count(result.Skipped, "file outside a gallery folder was", "files outside a gallery folder were")} skipped. Loose files lists them.");
    }

    // The one-time cleanup of images listed in several galleries (pre-release builds).
    private async Task CleanUpLegacyAsync()
    {
        if (_library?.Legacy is not { } legacy) return;
        var ok = await Ui.Confirm.AskAsync(
            $"Clean up {Format.Count(legacy.Images, "image", "images")}?",
            (legacy.Files > 0
                ? $"This deletes {Format.Count(legacy.Files, "extra copy", "extra copies")} ({Format.Size(legacy.Bytes)}) from the other galleries' folders, and those galleries no longer list the images. "
                : "The other galleries no longer list the images; no file is deleted. ") +
            "Each image stays in the gallery it was first shown in, or, when that folder lacks its file, moves to the first other gallery that has it. A file another image uses is never deleted. It can't be undone.",
            "Clean up", danger: legacy.Files > 0);
        if (!ok) return;
        var result = await RunLongAsync("Cleaning up…", (progress, ct) => LibraryService.CleanUpLegacyAsync(progress, ct),
            "Stopped. The images cleaned up until then are done; the rest are as they were.");
        if (result is not null)
            Ui.Toast.Success($"Cleaned up {Format.Count(result.Images, "image", "images")}, deleted {Format.Count(result.FilesDeleted, "extra copy", "extra copies")} ({Format.Size(result.BytesFreed)}).");
    }

    // Runs a long action with its progress in the page head and a Cancel button, then reloads.
    // Returns its result, or null when it failed or was stopped.
    private async Task<T?> RunLongAsync<T>(string title, Func<IProgress<string>, CancellationToken, Task<T>> work, string stoppedMessage) where T : class
    {
        T? result = null;
        bool ok;
        using (var run = CancellationTokenSource.CreateLinkedTokenSource(PageToken))
        {
            _sync = run;
            _syncTitle = title;
            _syncStatus = "Starting";
            // Progress<T> reports on the circuit's context; redraw at most a few times a second.
            var sinceRender = System.Diagnostics.Stopwatch.StartNew();
            var progress = new Progress<string>(status =>
            {
                _syncStatus = status;
                if (sinceRender.ElapsedMilliseconds < 200) return;
                sinceRender.Restart();
                StateHasChanged();
            });
            try
            {
                ok = await RunAsync(async () => result = await work(progress, run.Token));
            }
            finally
            {
                _sync = null;
            }
            if (!ok && run.IsCancellationRequested && !PageToken.IsCancellationRequested)
                Ui.Toast.Info(stoppedMessage);
        }
        if (!PageToken.IsCancellationRequested)
            await LoadAsync();
        return ok ? result : null;
    }

    private async Task DeleteShownAsync()
    {
        var galleries = _shown.ToList();
        var images = galleries.Sum(g => g.Images.Count);
        var ok = await Ui.Confirm.AskAsync(
            $"Delete {Format.Count(galleries.Count, "gallery", "galleries")}?",
            $"This deletes {Format.Count(galleries.Count, "gallery", "galleries")} with {Format.Count(images, "image", "images")} and their files ({Format.Size(galleries.Sum(g => g.Size))}). It can't be undone. If a frame shows one of them again, it's collected from scratch.",
            "Delete", danger: true);
        if (!ok) return;

        var deleted = 0;
        if (await RunAsync(async () => deleted = await LibraryService.DeleteGalleriesAsync(galleries.Select(g => g.Id), PageToken)))
        {
            Ui.Toast.Success($"Deleted {Format.Count(deleted, "gallery", "galleries")}.");
            await LoadAsync();
        }
    }
}
