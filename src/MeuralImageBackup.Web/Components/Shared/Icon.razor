@* Line icons on a 24 px grid, drawn with the current text color. *@
<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "frames": <rect x="3" y="8" width="13" height="12" rx="1" /><path d="M8 4h12a1 1 0 0 1 1 1v10" /><path d="M5.5 17.5l3-3.5 2.5 2.5 1.5-1.5 2 2.5" /> break;
        case "frame": <rect x="3" y="5" width="18" height="14" rx="1.2" /><path d="M9 5l3-3 3 3" /> break;
        case "image": <rect x="3" y="4" width="18" height="16" rx="1.5" /><circle cx="9" cy="9.5" r="1.8" /><path d="M3.5 18l5.5-5 4 3.5 3-2.5 4.5 4" /> break;
        case "grid": <rect x="4" y="4" width="7" height="7" rx="1" /><rect x="13" y="4" width="7" height="7" rx="1" /><rect x="4" y="13" width="7" height="7" rx="1" /><rect x="13" y="13" width="7" height="7" rx="1" /> break;
        case "list": <path d="M9 6h11M9 12h11M9 18h11" /><path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01" stroke-width="2.6" /> break;
        case "file": <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7zM14 3v4h4" /> break;
        case "file-missing": <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7zM14 3v4h4M10 12l4 4M14 12l-4 4" /> break;
        case "trash": <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-12M9 7V4h6v3" /> break;
        case "check": <path d="M5 12.5l4.5 4.5L19 7" /> break;
        case "x": <path d="M6 6l12 12M18 6L6 18" /> break;
        case "left": <path d="M15 5l-7 7 7 7" /> break;
        case "right": <path d="M9 5l7 7-7 7" /> break;
        case "down": <path d="M5 9l7 7 7-7" /> break;
        case "up": <path d="M5 15l7-7 7 7" /> break;
        case "download": <path d="M12 4v12M7 11l5 5 5-5M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2" /> break;
        case "external": <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /> break;
        case "clock": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "eye": <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="2.8" /> break;
        case "search": <circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /> break;
        case "info": <circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.5" /> break;
        case "alert": <path d="M12 3l10 18H2zM12 10v5M12 18v.5" /> break;
        case "disk": <ellipse cx="12" cy="6" rx="8" ry="3" /><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" /> break;
        case "sun": <circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" /> break;
        case "moon": <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z" /> break;
        case "monitor": <rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4" /> break;
        case "broom": <path d="M14 4l6 6M17 7l-6.5 6.5M4 20c1-4 3-6.5 6.5-6.5L13 16c0 3.5-2.5 5.5-6.5 6.5z" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
